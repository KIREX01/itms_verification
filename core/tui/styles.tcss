Screen {
    background: $background;
}
#metrics {
    height: auto;
    min-height: 1;
    max-height: 2;
    background: $panel;
    color: $text;
    padding: 0 1;
}
#tabs-content {
    height: 1fr;
}
.tab-horizontal {
    height: 1fr;
}
.table-panel {
    width: 65%;
    height: 100%;
}
.inspector-panel {
    width: 35%;
    height: 100%;
    border-left: solid $primary;
    padding: 1;
    overflow-y: auto;
}
#queue-action-bar {
    height: auto;
    min-height: 1;
    max-height: 2;
    background: $surface;
    color: $text-muted;
    padding: 0 1;
}
#queue-scope-bar {
    height: 1;
    background: $panel;
    color: $text;
    padding: 0 1;
}
#history-filter-bar {
    height: 1;
    background: $surface;
    color: $text-muted;
    padding: 0 1;
}
#batches-upload-bar {
    height: 1;
    background: $surface;
    color: $text-muted;
    padding: 0 1;
}
#batches-scope-bar {
    height: 1;
    background: $panel;
    color: $text;
    padding: 0 1;
}
#batches-table-title {
    height: 1;
    background: $panel;
    color: $text;
    padding: 0 1;
}
#table-batches {
    height: 8;
}
#batch-images-table-title {
    height: 1;
    background: $panel;
    color: $text;
    padding: 0 1;
}
#table-batch-images {
    height: 1fr;
}
#activity-container {
    height: 8;
    min-height: 4;
    border-top: solid $primary;
    background: $surface;
}
#activity-header {
    height: 1;
    background: $panel;
    color: $text;
    padding: 0 1;
}
#activity-log {
    height: 1fr;
    background: #111111;
    color: #e2e8f0;
    padding: 0 1;
}

PhotoLinkerModal, SingleOrderSubmissionModal, BatchSubmissionModal, PlateQuickEntryModal, BatchProgressModal, VaultLocationDialog {
    align: center middle;
    background: rgba(0, 0, 0, 0.75);
}

#modal-dialog {
    width: 90%;
    height: 85%;
    max-height: 92%;
    background: $surface;
    border: thick $primary;
    padding: 1 2;
}

.vault-location-modal {
    width: 80%;
    height: auto;
    max-height: 22;
    padding: 1 2;
}

.vault-input-row {
    height: 3;
    margin: 1 0;
}

.vault-input-row Input {
    width: 1fr;
    margin-right: 1;
}

.vault-input-row Button {
    margin-right: 1;
}

.vault-options-row {
    height: 3;
    margin: 0 0 1 0;
}

#vault-dialog-hint {
    height: 1;
    margin-bottom: 1;
    color: $text-muted;
}

.batch-submission-modal {
    width: 92%;
    height: 88%;
    max-height: 94%;
}

#modal-header {
    height: auto;
    background: $panel;
    color: $text;
    padding: 0 1;
    margin-bottom: 0;
}

#modal-batch-mode-indicator, #modal-submission-mode-indicator {
    height: auto;
    margin-top: 1;
    margin-bottom: 0;
    padding: 0 1;
}

#modal-table, #table-batch-review, #table-active-orders {
    height: 1fr;
    min-height: 6;
    margin-top: 1;
    border: solid $panel;
}

#modal-bottom-bar {
    dock: bottom;
    height: auto;
    background: $surface;
    border-top: solid $panel;
    padding-top: 1;
    margin-top: 1;
}

#chk-batch-dry-run, #chk-submission-dry-run {
    height: auto;
    margin-bottom: 0;
}

#modal-footer {
    height: 3;
    align: right middle;
    margin-top: 1;
}

#modal-footer Button {
    margin-left: 2;
    min-width: 18;
}

LandingAuthScreen {
    align: center middle;
    background: #0b0f19;
}

#auth-container {
    width: 94;
    max-width: 96%;
    height: auto;
    max-height: 94%;
    background: #111827;
    border: thick $primary;
    padding: 1 2;
    overflow-y: auto;
}

#auth-hero-panel {
    width: 28;
    height: auto;
    align-horizontal: center;
    border-right: solid #374151;
    padding-right: 2;
    margin-right: 2;
}

#auth-banner {
    width: 24;
    height: 14;
    content-align: center middle;
}

#auth-hero-title {
    text-align: center;
    margin-top: 1;
}

#auth-hero-footer {
    text-align: center;
    color: #64748b;
    margin-top: 1;
}

#auth-form-panel {
    width: 1fr;
    height: auto;
    overflow-y: auto;
}

#auth-tabs {
    height: auto;
}

.auth-hint {
    color: #cbd5e1;
    margin-bottom: 1;
}

.error-label {
    height: 1;
    margin-top: 0;
    margin-bottom: 1;
}

#btn-login-submit, #btn-reg-submit {
    width: 100%;
    margin-top: 1;
}

#auth-hero-db {
    text-align: center;
    margin-top: 1;
    padding: 0 1;
    background: #1f2937;
    border: round #374151;
    color: #e2e8f0;
}

.auth-db-btn-row {
    height: auto;
    margin: 1 0;
}

.auth-db-btn-row Button {
    margin-right: 1;
}

#auth-pg-inputs-container {
    height: auto;
    margin-top: 1;
    padding: 0 1;
    background: #1f2937;
    border: solid #374151;
}

#auth-pg-inputs-container Input {
    margin-bottom: 1;
}

#auth-pg-inputs-container Button {
    margin-right: 1;
}

/* ITMS WebApp Connection Hub (Tab 4) */
#itms-connection-pane {
    height: 1fr;
    padding: 0 1;
}

#itms-top-bar {
    height: 1;
    background: $panel;
    padding: 0 1;
    margin-bottom: 0;
}

#itms-main-split {
    height: 1fr;
}

#itms-status-column {
    width: 45%;
    height: 100%;
    border-right: solid $primary;
    padding-right: 1;
    overflow-y: auto;
}

#itms-status-card {
    background: #0b0f19;
    border: solid #374151;
    padding: 1;
    margin-bottom: 1;
    height: auto;
}

#itms-safety-card {
    background: #064e3b;
    color: #a7f3d0;
    border: solid #059669;
    padding: 1;
    margin-bottom: 1;
    height: auto;
}

#itms-safety-card.live-mode {
    background: #451a03;
    color: #fed7aa;
    border: solid #ea580c;
}

.hidden {
    display: none;
}

.itms-feedback {
    height: 1;
    margin-top: 0;
    margin-bottom: 1;
}

#itms-controls-column {
    width: 55%;
    height: 100%;
    padding-left: 1;
    overflow-y: auto;
}

.itms-section-title {
    background: $surface;
    color: $text;
    padding: 0 1;
    margin-bottom: 1;
    height: 1;
}

.itms-action-row {
    height: 3;
    margin-top: 1;
    margin-bottom: 1;
}

.itms-action-row Button {
    width: 1fr;
    margin-right: 1;
}

.itms-toolbar-row {
    height: 3;
    margin-top: 0;
    margin-bottom: 0;
}

.itms-input-filter {
    width: 1fr;
    margin-right: 1;
}

.itms-input-page {
    width: 6;
    min-width: 6;
    max-width: 8;
    margin-right: 1;
}

.itms-btn-fetch {
    min-width: 8;
    max-width: 10;
    margin-right: 1;
}

.itms-btn-nav {
    min-width: 4;
    max-width: 5;
    margin-right: 1;
}

.itms-actions-toolbar {
    height: 3;
    margin-top: 0;
    margin-bottom: 0;
}

.itms-actions-toolbar Button {
    width: 1fr;
    min-width: 12;
    margin-right: 1;
}

#itms-subview-filter-bar {
    height: 1;
    background: $surface;
    color: $text-muted;
    padding: 0 1;
    margin-bottom: 0;
}

.itms-view-container {
    height: 1fr;
}

#table-itms-orders, #table-itms-archive {
    height: 1fr;
    min-height: 8;
    margin-top: 0;
    margin-bottom: 0;
}

#queue-action-bar {
    height: 1;
    background: $surface;
    color: $text-muted;
    padding: 0 1;
}

.plate-entry-modal {
    width: 85%;
    max-width: 100;
    height: 85%;
    max-height: 38;
    background: $panel;
    border: thick $primary;
    padding: 1 2;
}

#table-active-orders {
    height: 1fr;
    min-height: 8;
    border: solid $surface;
    margin: 1 0;
}

#btn-close-palette {
    min-width: 14;
    height: 3;
    margin: 0 1;
    border: none;
}

.batch-progress-modal {
    width: 75%;
    max-width: 85;
    height: auto;
    max-height: 26;
    background: $panel;
    border: thick $primary;
    padding: 1 2;
}

#batch-progress-bar {
    width: 100%;
    margin: 1 0;
}

#batch-progress-title {
    margin-top: 1;
    text-style: bold;
}

#batch-progress-step {
    color: $text-muted;
    margin-bottom: 1;
}

#batch-progress-stats {
    background: $surface;
    padding: 0 1;
    margin-bottom: 1;
}

/* Settings & System Configuration Pane (Tab 5) */
#tab-settings {
    height: 1fr;
}

#settings-pane {
    height: 1fr;
    padding: 0 1;
}

#settings-container {
    height: 1fr;
    width: 100%;
}

#settings-top-bar {
    height: 1;
    background: $panel;
    padding: 0 1;
    margin-bottom: 1;
}

#settings-scroll-body {
    height: 1fr;
    scrollbar-gutter: stable;
}

#developer-settings-container {
    height: auto;
    width: 100%;
}

.settings-card {
    background: #0b0f19;
    border: solid #374151;
    padding: 0 1;
    margin-bottom: 1;
    height: auto;
}

.settings-card-title {
    margin-bottom: 0;
    text-style: bold;
    background: $surface;
    padding: 0 1;
}

.settings-row {
    height: auto;
    min-height: 2;
    margin-top: 1;
    margin-bottom: 0;
    align-vertical: middle;
}

.settings-label {
    width: 1fr;
}

.settings-input {
    width: 20;
    max-width: 25;
}

#settings-actions-bar {
    height: 3;
    margin-top: 1;
    margin-bottom: 0;
}

#settings-actions-bar Button {
    width: 1fr;
    margin-right: 1;
}

.settings-db-buttons {
    height: 3;
    margin-top: 1;
    margin-bottom: 0;
}

.settings-db-buttons Button {
    margin-right: 1;
}

#settings-db-feedback {
    height: 1;
    margin-top: 1;
    margin-bottom: 0;
    padding: 0 1;
}

#pg-config-container {
    height: auto;
}

/* Dashboard Pane (Tab 1) Styles */
DashboardPane {
    height: 1fr;
    background: $background;
    padding: 1 2;
}

#dashboard-container {
    height: auto;
}

#dashboard-header-banner {
    height: auto;
    background: $panel;
    color: $text;
    padding: 0 1;
    border: solid $primary;
    margin-bottom: 1;
}

.dashboard-card {
    height: auto;
    background: $surface;
    border: solid $panel;
    padding: 1;
    margin-bottom: 1;
}

.dashboard-card .card-title {
    height: 1;
    text-style: bold;
    margin-bottom: 1;
}

#pipeline-cards-container {
    height: auto;
    width: 100%;
    margin-top: 1;
    margin-bottom: 0;
    overflow-x: auto;
}

.pipeline-stage-card {
    width: 1fr;
    min-width: 22;
    height: auto;
    min-height: 7;
    background: $panel-darken-1;
    padding: 0 1;
    margin: 0;
}

.pipeline-stage-card:hover {
    background: $surface-lighten-1;
}

.pipeline-stage-card:focus {
    background: $surface-lighten-2;
}

.card-ingest {
    border: round cyan;
}
.card-ingest:hover {
    border: round #38bdf8;
}
.card-ingest:focus {
    border: double #38bdf8;
}

.card-vision {
    border: round magenta;
}
.card-vision:hover {
    border: round #f472b6;
}
.card-vision:focus {
    border: double #f472b6;
}

.card-association {
    border: round yellow;
}
.card-association:hover {
    border: round #fde047;
}
.card-association:focus {
    border: double #fde047;
}

.card-review {
    border: round dodgerblue;
}
.card-review:hover {
    border: round #60a5fa;
}
.card-review:focus {
    border: double #60a5fa;
}

.card-finalized {
    border: round green;
}
.card-finalized:hover {
    border: round #4ade80;
}
.card-finalized:focus {
    border: double #4ade80;
}

.pipeline-connector {
    width: 3;
    height: 7;
    content-align: center middle;
    color: $text-muted;
    text-style: bold;
}

#dashboard-distribution-chart {
    height: auto;
}

#dashboard-telemetry-row {
    height: auto;
    margin-bottom: 1;
}

.half-card {
    width: 1fr;
    margin-right: 1;
    margin-bottom: 0;
}

.half-card:last-of-type {
    margin-right: 0;
}

.action-button-row {
    height: 3;
    margin-top: 1;
}

.action-button-row Button {
    width: 1fr;
    margin-right: 1;
    height: 3;
}

.action-button-row Button:last-of-type {
    margin-right: 0;
}


