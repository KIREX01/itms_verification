#!/usr/bin/env bash
# ITMS Verification Copilot Unified CLI Controller
set -e

APP_DIR="/opt/itms"
if [[ ! -d "${APP_DIR}" ]]; then
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    APP_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
fi

cd "${APP_DIR}"

VENV_PYTHON="${APP_DIR}/.venv/bin/python"
if [[ ! -x "${VENV_PYTHON}" ]]; then
    VENV_PYTHON="python3"
fi

# Ensure terminal type is set for Textual TUI
export TERM="${TERM:-xterm-256color}"

# 1. Default action (no arguments): Launch Web Console in browser (v1.0.8 standard)
if [[ $# -eq 0 ]]; then
    exec "${VENV_PYTHON}" "${APP_DIR}/itms_cli.py"
fi

# 2. Explicit TUI request: Launch Terminal User Interface directly
if [[ "$1" == "--tui" || "$1" == "-t" || "$1" == "tui" ]]; then
    shift
    exec "${VENV_PYTHON}" "${APP_DIR}/manage.py" run_tui "$@"
fi

# 3. Informational and diagnostic commands run directly under active user session without sudo
case "$1" in
    -v|--version|version)
        exec "${VENV_PYTHON}" "${APP_DIR}/itms_cli.py" version
        ;;
    help|--help|-h)
        exec "${VENV_PYTHON}" "${APP_DIR}/itms_cli.py" help
        ;;
    status)
        exec "${VENV_PYTHON}" "${APP_DIR}/itms_cli.py" status "${@:2}"
        ;;
    manage)
        shift
        exec "${VENV_PYTHON}" "${APP_DIR}/manage.py" "$@"
        ;;
esac

# 4. Auto-elevate with sudo if not root for lifecycle mutations and uninstallation
if [[ "$(id -u)" -ne 0 ]]; then
    exec sudo "${VENV_PYTHON}" "${APP_DIR}/itms_cli.py" "$@"
fi

exec "${VENV_PYTHON}" "${APP_DIR}/itms_cli.py" "$@"
