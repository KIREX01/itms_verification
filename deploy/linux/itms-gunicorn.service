[Unit]
Description=CLOSE Copilot central server (gunicorn)
After=network.target postgresql.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/itms
EnvironmentFile=-/opt/itms/.env
Environment=DEPLOYMENT_ROLE=central
Environment=DJANGO_SETTINGS_MODULE=itms_project.settings
# One worker process (sync daemons + check-in live in-process), bounded thread pool.
ExecStart=/opt/itms/.venv/bin/gunicorn itms_project.wsgi:application \
    --bind 127.0.0.1:8000 --workers 1 --threads 16 --worker-class gthread \
    --timeout 120 --graceful-timeout 30 --keep-alive 5 \
    --max-requests 5000 --max-requests-jitter 500 \
    --access-logfile - --error-logfile -
Restart=always
RestartSec=3
KillMode=mixed

[Install]
WantedBy=multi-user.target
