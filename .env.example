# ITMS Verification Copilot - Environment Template
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
DB_ENGINE=sqlite
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com

# Media & Storage
MEDIA_ROOT=media
VAULT_SUBDIR=vault
CROPS_SUBDIR=crops

# Vision & OCR Models
PLATE_YOLO_WEIGHTS=models/license-plate-finetune-v1n.pt
PLATE_DETECTOR_CONF_THRESHOLD=0.35
OCR_MIN_CONFIDENCE=0.55
USE_PADDLEOCR=True

# Fuzzy Matching
FUZZY_EXACT_THRESHOLD=100
FUZZY_ACCEPT_THRESHOLD=85
FUZZY_REJECT_THRESHOLD=75

# ITMS Integration
ITMS_SUBMISSION_BACKEND=web
ITMS_API_BASE_URL=https://stock.itms.ug
ITMS_LOGIN_ENDPOINT=/site/login
ITMS_REFRESH_ENDPOINT=/api/auth/refresh
ITMS_USERNAME=
ITMS_PASSWORD=
ITMS_REQUEST_TIMEOUT_SECONDS=30
ITMS_SIMULATED_LATENCY_MS=150
ITMS_FAILURE_INJECTION_RATE=0.0