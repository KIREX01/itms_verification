# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Force Linux shell scripts, systemd units, cron, and config files to LF
itms text eol=lf
scripts/* text eol=lf
*.sh text eol=lf
*.bash text eol=lf
*.service text eol=lf
*.cron text eol=lf
*.conf text eol=lf
*.py text eol=lf
*.js text eol=lf
*.html text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf

# Windows command and PowerShell scripts use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.pt binary
*.onnx binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
