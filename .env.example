# ITMS Verification Copilot - Environment Configuration Template
# Copy this file to .env and fill in real values. Never commit .env to version control.

# --- Django Web Framework ---
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Database Provider ---
# Default: SQLite (db.sqlite3) - zero-configuration, recommended for all client/operator machines
DB_ENGINE=sqlite

# Optional: PostgreSQL (Uncomment and configure if connecting to enterprise PostgreSQL)
# DB_ENGINE=postgresql
# POSTGRES_DB=itms_db
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=change_this_password
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# --- Initial Operator / Admin Account ---
# Created automatically on first bootstrap if no users exist
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin

# --- Evidence Vault & Media Storage ---
MEDIA_ROOT=media
VAULT_SUBDIR=vault
CROPS_SUBDIR=crops

# --- Vision Pipeline & OCR ---
PLATE_YOLO_WEIGHTS=models/license-plate-finetune-v1n.pt  # Fine-tuned Plate Nano (Default)
# PLATE_YOLO_WEIGHTS=models/license-plate-finetune-v1s.pt  # Fine-tuned Plate Small (Higher accuracy)
PLATE_DETECTOR_CONF_THRESHOLD=0.35
OCR_MIN_CONFIDENCE=0.55
USE_PADDLEOCR=True

# --- Fuzzy Order Matcher ---
FUZZY_EXACT_THRESHOLD=100
FUZZY_ACCEPT_THRESHOLD=85
FUZZY_REJECT_THRESHOLD=75

# --- Simulated ITMS (Testing/Offline) ---
ITMS_SIMULATED_LATENCY_MS=150
ITMS_FAILURE_INJECTION_RATE=0.0

# --- Live ITMS Web App Integration ---
ITMS_SUBMISSION_BACKEND=web          # "web" (production live) or "mock" (offline test)
ITMS_API_BASE_URL=https://stock.itms.ug
ITMS_LOGIN_ENDPOINT=/site/login
ITMS_REFRESH_ENDPOINT=/api/auth/refresh
ITMS_USERNAME=operator@example.com
ITMS_PASSWORD=change_this_password
ITMS_REQUEST_TIMEOUT_SECONDS=30
