#!/usr/bin/env bash
# ITMS Verification Copilot Unified CLI Controller
set -e

APP_DIR="/opt/itms"
if [[ ! -d "${APP_DIR}" ]]; then
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    APP_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
fi

cd "${APP_DIR}"

VENV_PYTHON="${APP_DIR}/.venv/bin/python"
if [[ ! -x "${VENV_PYTHON}" ]]; then
    VENV_PYTHON="python3"
fi

# Ensure terminal type is set for Textual TUI
export TERM="${TERM:-xterm-256color}"

# If no arguments or user explicitly requested TUI, launch TUI directly without sudo
if [[ $# -eq 0 || "$1" == "--tui" || "$1" == "-t" || "$1" == "tui" ]]; then
    if [[ "$1" == "--tui" || "$1" == "-t" || "$1" == "tui" ]]; then
        shift
    fi
    exec "${VENV_PYTHON}" "${APP_DIR}/manage.py" run_tui "$@"
fi

# Informational and diagnostic commands run directly under active user session without sudo
case "$1" in
    -v|--version|version)
        exec "${VENV_PYTHON}" "${APP_DIR}/manage.py" itms_ctl version
        ;;
    help|--help|-h)
        exec "${VENV_PYTHON}" "${APP_DIR}/manage.py" itms_ctl help
        ;;
    status)
        exec "${VENV_PYTHON}" "${APP_DIR}/manage.py" itms_ctl status "${@:2}"
        ;;
    manage)
        shift
        exec "${VENV_PYTHON}" "${APP_DIR}/manage.py" "$@"
        ;;
esac

# Auto-elevate with sudo if not root for lifecycle mutations (start, stop, restart, maintenance, switch, rollback, update, bootstrap, clear)
if [[ "$(id -u)" -ne 0 ]]; then
    exec sudo "${VENV_PYTHON}" "${APP_DIR}/manage.py" itms_ctl "$@"
fi

exec "${VENV_PYTHON}" "${APP_DIR}/manage.py" itms_ctl "$@"
