# ITMS Verification Copilot - Environment Template
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
DB_ENGINE=sqlite
DJANGO_SUPERUSER_USERNAME=admin
# Generated per install by scripts/bootstrap.py (never a shared default)
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=admin@example.com

# Media & Storage
MEDIA_ROOT=media
VAULT_SUBDIR=vault
CROPS_SUBDIR=crops

# Vision & OCR Models
PLATE_YOLO_WEIGHTS=models/license-plate-finetune-v1n.pt
PLATE_DETECTOR_CONF_THRESHOLD=0.35
OCR_MIN_CONFIDENCE=0.55
USE_PADDLEOCR=True

# Fuzzy Matching
FUZZY_EXACT_THRESHOLD=100
FUZZY_ACCEPT_THRESHOLD=85
FUZZY_REJECT_THRESHOLD=75

# ITMS Integration
ITMS_SUBMISSION_BACKEND=web
ITMS_API_BASE_URL=https://stock.itms.ug
ITMS_LOGIN_ENDPOINT=/site/login
ITMS_REFRESH_ENDPOINT=/api/auth/refresh
ITMS_USERNAME=
ITMS_PASSWORD=
ITMS_REQUEST_TIMEOUT_SECONDS=30
ITMS_SIMULATED_LATENCY_MS=150
ITMS_FAILURE_INJECTION_RATE=0.0

# 2FA Email Service (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=CLOSE Copilot <notifications@info.kirex.online>
SIGNUP_2FA_ENABLED=True
# --- Install control (CLOSE Copilot v1.2.0+) -----------------------------------
# central = the backoffice server (close.kirex.online); edge = laptop / workstation (default)
# DEPLOYMENT_ROLE=edge
# Laptops refuse to run until enrolled (itms enroll <server> <code>). Developers only:
# CLOSE_REQUIRE_ENROLLMENT=0
# Who may open this laptop's web pages: pc_and_paired (default) or open
# CLOSE_LOCAL_ACCESS=pc_and_paired
