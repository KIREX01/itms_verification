Screen {
    background: $background;
}
#metrics {
    height: 1;
    background: $panel;
    color: $text;
    padding: 0 1;
}
#tabs-content {
    height: 1fr;
}
.tab-horizontal {
    height: 1fr;
}
.table-panel {
    width: 65%;
    height: 100%;
}
.inspector-panel {
    width: 35%;
    height: 100%;
    border-left: solid $primary;
    padding: 1;
    overflow-y: auto;
}
#history-filter-bar {
    height: 1;
    background: $surface;
    color: $text-muted;
    padding: 0 1;
}
#batches-upload-bar {
    height: 1;
    background: $surface;
    color: $text-muted;
    padding: 0 1;
}
#batches-table-title {
    height: 1;
    background: $panel;
    color: $text;
    padding: 0 1;
}
#table-batches {
    height: 8;
}
#batch-images-table-title {
    height: 1;
    background: $panel;
    color: $text;
    padding: 0 1;
}
#table-batch-images {
    height: 1fr;
}
#activity-container {
    height: 11;
    border-top: solid $primary;
    background: $surface;
}
#activity-header {
    height: 1;
    background: $panel;
    color: $text;
    padding: 0 1;
}
#activity-log {
    height: 1fr;
    background: #111111;
    color: #e2e8f0;
    padding: 0 1;
}

PhotoLinkerModal {
    align: center middle;
    background: rgba(0, 0, 0, 0.75);
}

#modal-dialog {
    width: 85%;
    height: 80%;
    background: $surface;
    border: thick $primary;
    padding: 1 2;
}

#modal-header {
    height: auto;
    background: $panel;
    color: $text;
    padding: 1;
    margin-bottom: 1;
}

#modal-table {
    height: 1fr;
}

#modal-footer {
    height: 3;
    align: right middle;
    padding-top: 1;
}

#modal-footer Button {
    margin-left: 2;
}

LandingAuthScreen {
    align: center middle;
    background: #0b0f19;
}

#auth-container {
    width: 94;
    max-width: 96%;
    height: auto;
    max-height: 94%;
    background: #111827;
    border: thick $primary;
    padding: 1 2;
    overflow-y: auto;
}

#auth-hero-panel {
    width: 28;
    height: auto;
    align-horizontal: center;
    border-right: solid #374151;
    padding-right: 2;
    margin-right: 2;
}

#auth-banner {
    width: 24;
    height: 14;
    content-align: center middle;
}

#auth-hero-title {
    text-align: center;
    margin-top: 1;
}

#auth-hero-footer {
    text-align: center;
    color: #64748b;
    margin-top: 1;
}

#auth-form-panel {
    width: 1fr;
    height: auto;
    overflow-y: auto;
}

#auth-tabs {
    height: auto;
}

.auth-hint {
    color: #cbd5e1;
    margin-bottom: 1;
}

.error-label {
    height: 1;
    margin-top: 0;
    margin-bottom: 1;
}

#btn-login-submit, #btn-reg-submit {
    width: 100%;
    margin-top: 1;
}

/* ITMS WebApp Connection Hub (Tab 4) */
#itms-connection-pane {
    height: 1fr;
    padding: 0 1;
}

#itms-top-bar {
    height: 1;
    background: $panel;
    padding: 0 1;
    margin-bottom: 0;
}

#itms-main-split {
    height: 1fr;
}

#itms-status-column {
    width: 45%;
    height: 100%;
    border-right: solid $primary;
    padding-right: 1;
    overflow-y: auto;
}

#itms-status-card {
    background: #0b0f19;
    border: solid #374151;
    padding: 1;
    margin-bottom: 1;
    height: auto;
}

#itms-safety-card {
    background: #064e3b;
    color: #a7f3d0;
    border: solid #059669;
    padding: 1;
    margin-bottom: 1;
    height: auto;
}

.itms-feedback {
    height: 1;
    margin-top: 0;
    margin-bottom: 1;
}

#itms-controls-column {
    width: 55%;
    height: 100%;
    padding-left: 1;
    overflow-y: auto;
}

.itms-section-title {
    background: $surface;
    color: $text;
    padding: 0 1;
    margin-bottom: 1;
    height: 1;
}

.itms-action-row {
    height: 3;
    margin-top: 1;
    margin-bottom: 1;
}

.itms-action-row Button {
    width: 1fr;
    margin-right: 1;
}

.itms-toolbar-row {
    height: 3;
    margin-top: 0;
    margin-bottom: 0;
}

.itms-input-filter {
    width: 1fr;
    margin-right: 1;
}

.itms-input-page {
    width: 6;
    min-width: 6;
    max-width: 8;
    margin-right: 1;
}

.itms-btn-fetch {
    min-width: 8;
    max-width: 10;
    margin-right: 1;
}

.itms-btn-nav {
    min-width: 4;
    max-width: 5;
    margin-right: 1;
}

.itms-actions-toolbar {
    height: 3;
    margin-top: 0;
    margin-bottom: 0;
}

.itms-actions-toolbar Button {
    width: 1fr;
    min-width: 12;
    margin-right: 1;
}

#itms-subview-filter-bar {
    height: 1;
    background: $surface;
    color: $text-muted;
    padding: 0 1;
    margin-bottom: 0;
}

.itms-view-container {
    height: 1fr;
}

#table-itms-orders, #table-itms-archive {
    height: 1fr;
    min-height: 8;
    margin-top: 0;
    margin-bottom: 0;
}



