# Copy this file to .env and fill in real values. Never commit .env.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- PostgreSQL ---
POSTGRES_DB=itms_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Superuser bootstrap (used only by create_superuser_if_none management command) ---
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change_this_password

# --- Evidence vault ---
MEDIA_ROOT=media
VAULT_SUBDIR=vault

# --- Vision pipeline ---
PLATE_YOLO_WEIGHTS=models/license-plate-finetune-v1n.pt  # Fine-tuned Plate Nano (Default)
# PLATE_YOLO_WEIGHTS=models/license-plate-finetune-v1s.pt  # Fine-tuned Plate Small (Higher accuracy)
PLATE_DETECTOR_CONF_THRESHOLD=0.35
OCR_MIN_CONFIDENCE=0.55
USE_PADDLEOCR=True

# --- Fuzzy order matcher ---
FUZZY_EXACT_THRESHOLD=100
FUZZY_ACCEPT_THRESHOLD=85
FUZZY_REJECT_THRESHOLD=75

# --- Simulated ITMS ---
ITMS_SIMULATED_LATENCY_MS=150
ITMS_FAILURE_INJECTION_RATE=0.0

# --- Live ITMS Web App Integration ---
ITMS_SUBMISSION_BACKEND=mock          # switch to "live" when connecting to production ITMS
ITMS_API_BASE_URL=https://stock.itms.ug
ITMS_LOGIN_ENDPOINT=/site/login       # or custom API auth endpoint e.g. /api/auth/login
ITMS_REFRESH_ENDPOINT=/api/auth/refresh
ITMS_USERNAME=operator@example.com
ITMS_PASSWORD=change_this_password
ITMS_REQUEST_TIMEOUT_SECONDS=30

